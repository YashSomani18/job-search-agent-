# Groq API Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Gmail SMTP Configuration
# Your Gmail address
GMAIL_USER=your_email@gmail.com
# Generate an App Password: https://support.google.com/accounts/answer/185833
# Go to Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your_gmail_app_password_here
# Recipient email address (can be the same as GMAIL_USER)
EMAIL_TO=recipient@gmail.com

# Job Search Configuration
# Comma-separated list of job keywords to search for
# Personalized for: Java SpringBoot, Go, React, Software Engineering roles
JOB_KEYWORDS=Java Developer,SpringBoot Developer,Go Developer,React Developer,Software Engineer,Backend Developer,SDE-1
# Job location - Pan India only (Remote or India-based)
JOB_LOCATION=India
# Maximum number of jobs to send in email (default: 100)
MAX_JOBS=100

# User Profile Configuration (Personalized based on your resume)
# Your skills - comma-separated list (from your resume)
USER_SKILLS=Java, SpringBoot, Spring Data JPA, Kafka, AWS S3, Docker, PostgreSQL, MySQL, Redis, MongoDB, React.js, Node.js, Express.js, Python, SQL, Git, Jenkins, Maven, Lombok
# Your experience level: Entry/Mid/Senior/Lead
USER_EXPERIENCE_LEVEL=Mid
# Years of experience (e.g., 1.5)
USER_YEARS_EXPERIENCE=1.5
# Current role (e.g., SDE-1)
USER_CURRENT_ROLE=SDE-1
# Preferred industry
USER_INDUSTRY=Tech,Software Engineering,Backend Development
# Job preferences - specific requirements
USER_PREFERENCES=Pan India only, Remote jobs fine, WFO must be in India, SDE-1 level, 1+ years experience, Java SpringBoot or Go or React

# Web Scraping Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
REQUEST_DELAY=2.0
REQUEST_TIMEOUT=30

# LinkedIn Configuration (Optional - for better results)
# Note: LinkedIn has strong anti-scraping measures
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
# Enable/disable LinkedIn search (true/false)
LINKEDIN_ENABLED=true

# Indeed Configuration
# Enable/disable Indeed search (true/false)
INDEED_ENABLED=true

# AI Filtering Configuration
# Custom prompt for AI filtering (optional)
AI_FILTER_PROMPT=Filter jobs that match the user's skills and preferences. Return only job titles that are relevant. Focus on SDE-1 level positions with 1+ years experience in Java SpringBoot, Go, or React. Ensure locations are in India only.

# Naukri Configuration
# Enable/disable Naukri search (true/false)
# Naukri.com is a popular Indian job portal with excellent coverage of Indian jobs
NAUKRI_ENABLED=true
